                                    <label class="tit" for="data-weather-config-display-mode">화면설정</label><a href="#config-help" class="label-help">화면설정 설명보기</a>
                                    <div class="select-wrap">
                                        <select name="display-mode" title="화면설정" id="data-weather-config-display-mode">
